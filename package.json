{
  "name": "container-converter",
  "version": "0.1.0",
  "description": "Convert Dockerfiles to Open Horizon Service Definition Files",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "container-converter": "dist/cli/index.js",
    "container-converter-mcp": "dist/mcp/server.js",
    "container-converter-tui": "dist/tui/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:dev": "tsc --sourceMap",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "validate": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "docker",
    "dockerfile",
    "open-horizon",
    "edge-computing",
    "converter",
    "sdf"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@json-types/compose": "^0.10.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "ajv": "^8.17.1",
    "commander": "^11.1.0",
    "dockerfile-ast": "^0.6.1",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.9",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
